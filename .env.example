# Database (see docker-compose.yml)
DATABASE_URL="postgresql://personal_ai:personal_ai_dev_password@localhost:5432/personal_ai"

# NextAuth (v5 reads AUTH_* primarily, NEXTAUTH_* kept for compatibility)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Seeded single user (used only by scripts/seed.ts)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="You"

# LLM provider selection: ollama | anthropic | openai
LLM_PROVIDER="ollama"

# Ollama (default provider, must be running locally)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="qwen3:8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Anthropic (optional, only used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# OpenAI (optional, only used if LLM_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_EMBED_MODEL="text-embedding-3-small"
